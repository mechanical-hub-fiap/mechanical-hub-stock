# Valores locais (compatíveis com o compose.yaml).
# No cluster: ConfigMap/Secret preenchidos pelo pipeline; sem chave AWS (os pods usam a LabRole).

# PostgreSQL. Deploy: outputs do mechanical-hub-database
DB_URL=jdbc:postgresql://localhost:5432/stock
DB_USER=stock
DB_PASSWORD=secret

# SQS. Deploy: outputs sqs_queue_urls / sqs_dlq_urls do mechanical-hub-infra
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localhost:4566
STOCK_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-stock-commands.fifo
STOCK_COMMANDS_DLQ_URL=http://localhost:4566/000000000000/mechanical-hub-stock-commands-dlq.fifo
ORCHESTRATOR_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-orchestrator-events.fifo
OUTBOX_RELAY_ENABLED=true

# OpenTelemetry (sem coletor: none)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=none
